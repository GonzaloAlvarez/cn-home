# cn-home/traefik-lan/dynamic.yml — the routing contract between cn-home and
# every other compose project on kaiser.lan. Each subdomain forwards to a
# 127.0.0.1:<port> binding on the host (because Traefik runs network_mode: host).
#
# ────────────────────────────────────────────────────────────────────────────
# LLM-AGENT EDIT TARGET
# Add a new service by appending a router (HTTPS) + service block below.
# - The router rule MUST be `Host(\`<sub>.${LAN_DOMAIN}\`)` so it works for any
#   apex; envsubst expands ${LAN_DOMAIN} at render-time.
# - The service must bind to a 127.0.0.1:<port> on the kaiser host. If the new
#   service is in cn-observability or another sibling repo, document the port
#   there too.
# - The HTTP catch-all redirect under `http-catchall` is global; new services
#   don't need their own redirect middleware.
# ────────────────────────────────────────────────────────────────────────────
http:
  middlewares:
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: true

    # ── Authentik forward-auth (LAN side) ────────────────────────────────
    # Sends every request through the Authentik embedded outpost on
    # neptune.lan before forwarding upstream. The outpost picks the right
    # proxy provider from the request's Host header (configured providers:
    # shelfmark-lan, calibre-lan — see cn-authentik/setup-books-proxy-sso.sh).
    # If the user has a valid session the outpost returns 200 (plus any
    # `Authorization: Basic` it was told to inject from group attributes);
    # we forward those headers upstream. NOTE: this gate answers non-browser
    # clients with an Authentik HTML page — apps with native/companion
    # clients (RomM + Argosy) must use native OIDC instead.
    #
    # `tls.ca: /certs/root_ca.crt` makes traefik-lan trust step-ca for the
    # outbound forward-auth call to auth.neptune.lan (which serves a
    # step-ca leaf). The mount already exists for LEGO_CA_CERTIFICATES.
    authentik-lan:
      forwardAuth:
        address: https://auth.neptune.lan/outpost.goauthentik.io/auth/traefik
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
          - Authorization
        tls:
          ca: /certs/root_ca.crt

    # ── RomM canonical-URL redirect ──────────────────────────────────────
    # roms.kaiser.lan → roms.lab.gn.al (301). RomM has ONE origin: its OIDC
    # redirect URI is static, the OAuth state lives in a host-scoped cookie
    # and the Argosy pairing QR is built from window.location.origin. Rendered
    # by envsubst scoped to ${LAN_DOMAIN}, so Traefik's ${1} survives.
    roms-canonical:
      redirectRegex:
        regex: "^https://roms\\.${LAN_DOMAIN}/(.*)"
        replacement: "https://roms.lab.gn.al/${1}"
        permanent: true

  routers:
    # Catch-all: any HTTP request hitting Traefik on :80 is bumped to :443.
    http-catchall:
      rule: "HostRegexp(`.+`)"
      entryPoints: [web]
      middlewares: [https-redirect]
      service: noop@internal
      priority: 1

    home:
      rule: "Host(`home.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: home
      tls:
        certResolver: stepca

    grafana:
      rule: "Host(`grafana.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: grafana
      tls:
        certResolver: stepca

    prometheus:
      rule: "Host(`prometheus.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: prometheus
      tls:
        certResolver: stepca

    alertmanager:
      rule: "Host(`alertmanager.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: alertmanager
      tls:
        certResolver: stepca

    loki:
      rule: "Host(`loki.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: loki
      tls:
        certResolver: stepca

    portainer:
      rule: "Host(`portainer.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: portainer
      tls:
        certResolver: stepca

    # cn-bittorrent — torrent core. Backends are 127.0.0.1:<port> on
    # kaiser, published by the ts-torrent sidecar in cn-bittorrent
    # (which owns the network namespace; the qb/*arr suite share it).
    # See ~/dev/cn-bittorrent/docker-compose.yml for the source of truth.
    torrent:
      rule: "Host(`torrent.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: torrent
      tls:
        certResolver: stepca

    sonarr:
      rule: "Host(`sonarr.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: sonarr
      tls:
        certResolver: stepca

    radarr:
      rule: "Host(`radarr.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: radarr
      tls:
        certResolver: stepca

    # FlareSolverr is a headless API (no UI) — this route exists only so the
    # Dashy tile can run an up/down status probe against its health root.
    flaresolverr:
      rule: "Host(`flaresolverr.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: flaresolverr
      tls:
        certResolver: stepca

    # cn-books stack — gated by Authentik forward-auth (authentik-lan).
    # Authentik forwards X-authentik-username to the upstream; Shelfmark +
    # Calibre-Web auto-login from it, Audiobookshelf is gated (own login behind).
    shelfmark:
      rule: "Host(`shelfmark.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      middlewares:
        - authentik-lan
      service: shelfmark
      tls:
        certResolver: stepca

    calibre:
      rule: "Host(`calibre.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      middlewares:
        - authentik-lan
      service: calibre
      tls:
        certResolver: stepca

    # Audiobookshelf is NOT Authentik-integrated — it uses its own local login
    # and is intentionally ungated. ABS supports only local + native OIDC (no
    # reverse-proxy header/Basic auth), and its single OIDC issuer isn't reachable
    # from a plain-LAN browser, so SSO was dropped in favor of standalone local
    # auth. Keep ABS's own username/password in sync with Authentik manually.
    audiobookshelf:
      rule: "Host(`audiobookshelf.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: audiobookshelf
      tls:
        certResolver: stepca

    prowlarr:
      rule: "Host(`prowlarr.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: prowlarr
      tls:
        certResolver: stepca

    lidarr:
      rule: "Host(`lidarr.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: lidarr
      tls:
        certResolver: stepca

    readarr:
      rule: "Host(`readarr.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: readarr
      tls:
        certResolver: stepca

    # raidnas (Synology DS418) — DSM web UI. Not on the tailnet; kaiser
    # routes to the appliance directly via pfSense gateway. step-ca
    # terminates TLS so the browser stops yelling about the self-signed
    # cert DSM ships with on :5001.
    raidnas:
      rule: "Host(`raidnas.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: raidnas
      tls:
        certResolver: stepca

    # cn-media — jellyfin. Lives on kaiser like every other *.kaiser.lan
    # service; cn-home's CoreDNS already wildcards `*.kaiser.lan` →
    # 10.1.1.140, so no pfSense Host Override needed. Backend is the
    # ts-jellyfin sidecar's published 127.0.0.1:8096.
    jellyfin:
      rule: "Host(`jellyfin.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: jellyfin
      tls:
        certResolver: stepca

    # cn-roms — RomM ROM library. Backend is the ts-roms sidecar's
    # published 127.0.0.1:8083. Canonical URL is roms.lab.gn.al (baked into
    # ROMM_BASE_URL + the single OIDC callback in cn-roms); RomM gates
    # browsers itself via native Authentik OIDC and companion apps (Argosy)
    # via Client API Tokens — no forward-auth here any more.
    #
    # Same split-horizon shape as chat: roms.lab.gn.al gets a step-ca leaf
    # here for LAN clients (Technitium record + pfSense host override
    # roms.lab.gn.al → kaiser validate HTTP-01); tailnet clients hit the VPS
    # traefik-lab (LE wildcard) via cn-roms's consul-register. Argosy on
    # Android must use the tailnet path — stock Android doesn't trust step-ca.
    roms:
      rule: "Host(`roms.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      middlewares:
        - roms-canonical
      service: noop@internal
      tls:
        certResolver: stepca
    roms-lab:
      rule: "Host(`roms.lab.gn.al`)"
      entryPoints: [websecure]
      service: roms
      tls:
        certResolver: stepca

    # cn-fitness — SparkyFitness. Backend is the ts-fitness sidecar's
    # published 127.0.0.1:3004 (frontend nginx, which proxies /api/* to
    # backend on :3010 inside the same netns). Native Android/iOS apps
    # use the tailnet path (fitness.lab.gn.al) — step-ca isn't trusted
    # on stock mobile.
    fitness:
      rule: "Host(`fitness.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: fitness
      tls:
        certResolver: stepca

    # cn-librechat — LibreChat (AI chat, AWS Bedrock backend). Backend is the
    # ts-librechat sidecar's published 127.0.0.1:3080. Native OIDC gating is
    # done by LibreChat itself (Authentik), NOT the authentik-lan forward-auth
    # middleware — so no middleware here.
    #
    # Canonical URL is chat.lab.gn.al (baked into DOMAIN_SERVER + the OIDC
    # callback). Both hostnames route to the same backend and LibreChat
    # self-canonicalizes — same shape as cn-outline's outline-lan/outline-lab.
    # chat.lab.gn.al gets a step-ca leaf here for LAN clients (pfSense
    # split-horizon override chat.lab.gn.al → kaiser validates HTTP-01);
    # tailnet clients hit the VPS traefik-lab LE wildcard via consul-register.
    chat-lan:
      rule: "Host(`chat.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: chat
      tls:
        certResolver: stepca
    chat-lab:
      rule: "Host(`chat.lab.gn.al`)"
      entryPoints: [websecure]
      service: chat
      tls:
        certResolver: stepca

    # cn-exercises — static exercises-dataset site (nginx). Backend is the
    # ts-exercises sidecar's published 127.0.0.1:8086. No auth gating —
    # read-only static content.
    #
    # Same split-horizon shape as chat: exercises.lab.gn.al gets a step-ca
    # leaf here for LAN clients (pfSense Host Override
    # exercises.lab.gn.al → kaiser validates HTTP-01); tailnet clients hit
    # the VPS traefik-lab LE wildcard via cn-exercises's consul-register.
    exercises-lan:
      rule: "Host(`exercises.${LAN_DOMAIN}`)"
      entryPoints: [websecure]
      service: exercises
      tls:
        certResolver: stepca
    exercises-lab:
      rule: "Host(`exercises.lab.gn.al`)"
      entryPoints: [websecure]
      service: exercises
      tls:
        certResolver: stepca

  services:
    home:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8085"
    grafana:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:3000"
    prometheus:
      loadBalancer:
        servers:
          # Host port 9091 (not 9090) — kaiser's pmproxy occupies 9090.
          - url: "http://127.0.0.1:9091"
    alertmanager:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:9093"
    loki:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:3100"
    portainer:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:9000"

    torrent:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8080"   # qbittorrent WebUI
    sonarr:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8989"
    radarr:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:7878"
    flaresolverr:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8191"
    shelfmark:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8084"
    calibre:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8092"
    audiobookshelf:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:13378"
    prowlarr:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:9696"
    lidarr:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8686"
    readarr:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8787"

    # raidnas DSM HTTP backend. 10.120.26.20:5000 is reachable directly
    # from kaiser via pfSense (the NAS is not on the tailnet). For the
    # tailnet ingress on raidnas.lab.gn.al, see cn-root-docker plan §6
    # (VPS Consul registration via traefik-lab + cn-infra subnet route).
    raidnas:
      loadBalancer:
        servers:
          - url: "http://10.120.26.20:5000"

    # cn-media jellyfin backend — 127.0.0.1:8096 is published on the
    # kaiser host by the ts-jellyfin Tailscale sidecar in cn-media.
    # Tailnet ingress (jellyfin.lab.gn.al) is wired via the cn-media
    # consul-register loop + VPS traefik-lab.
    jellyfin:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8096"

    # cn-roms RomM backend — 127.0.0.1:8083 published by the ts-roms
    # Tailscale sidecar in cn-roms (host port 8083, container port 8080;
    # cn-bittorrent's qbittorrent already owns 127.0.0.1:8080 on this
    # host). passHostHeader so RomM sees roms.lab.gn.al (canonical/OIDC
    # handling). Tailnet ingress (roms.lab.gn.al) is wired via cn-roms's
    # consul-register loop + VPS traefik-lab.
    roms:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://127.0.0.1:8083"

    # cn-fitness SparkyFitness backend — 127.0.0.1:3004 published by the
    # ts-fitness Tailscale sidecar in cn-fitness (host port 3004 → container
    # port 80 on the frontend nginx). Tailnet ingress (fitness.lab.gn.al) is
    # wired via cn-fitness's consul-register loop + VPS traefik-lab.
    fitness:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:3004"

    # cn-librechat LibreChat backend — 127.0.0.1:3080 published by the
    # ts-librechat Tailscale sidecar in cn-librechat. passHostHeader so
    # LibreChat sees the real Host (needed for OIDC/canonical handling).
    # Tailnet ingress (chat.lab.gn.al) is wired via cn-librechat's
    # consul-register loop + VPS traefik-lab.
    chat:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://127.0.0.1:3080"

    # cn-exercises static site backend — 127.0.0.1:8086 published by the
    # ts-exercises Tailscale sidecar in cn-exercises. Tailnet ingress
    # (exercises.lab.gn.al) is wired via cn-exercises's consul-register
    # loop + VPS traefik-lab.
    exercises:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8086"
