#!/usr/bin/env bash
# cn-home/deploy — idempotent: program pfSense Domain Override, rsync the
# repo to kaiser, run `docker compose up -d` remotely, then verify.
#
#   ./deploy                          # cn-home only
#   ./deploy --with-observability     # also deploy ../cn-observability/ first
#                                     (its .env on kaiser comes from Kauket:
#                                      kaiser.cn_observability_env, not from here)
#   ./deploy --skip-dns               # skip the pfSense step (.pf-creds missing)
#   ./deploy --skip-verify            # skip the post-deploy curl checks

set -euo pipefail

cd "$(dirname "$0")"
HERE="$(pwd)"

WITH_OBS=false
SKIP_DNS=false
SKIP_VERIFY=false
for arg in "$@"; do
  case "$arg" in
    --with-observability) WITH_OBS=true ;;
    --skip-dns)           SKIP_DNS=true ;;
    --skip-verify)        SKIP_VERIFY=true ;;
    *) echo "unknown flag: $arg" >&2; exit 2 ;;
  esac
done

if [ ! -f .env ]; then
  echo ".env missing — running ./setup.sh first ..." >&2
  ./setup.sh
fi
set -o allexport
# shellcheck disable=SC1091
source .env
set +o allexport

: "${PKI_IP:?PKI_IP missing in .env}"
: "${LAN_DOMAIN:?LAN_DOMAIN missing in .env}"
: "${KAISER_IP:?KAISER_IP missing in .env}"
: "${KAISER_SSH:?KAISER_SSH missing in .env}"
: "${KAISER_REMOTE_DIR:?KAISER_REMOTE_DIR missing in .env}"
KAISER_SSH_KEY="${KAISER_SSH_KEY/#\~/$HOME}"

SSH_OPTS=(
  -o ConnectTimeout=10
  -o BatchMode=yes
  -o UserKnownHostsFile=/dev/null
  -o StrictHostKeyChecking=no
  -i "$KAISER_SSH_KEY"
)
# Away-from-home (CLAUDE.md §5.4): route ssh/rsync/scp through the
# cn-socksnode SOCKS proxy by exporting e.g.
#   KAISER_SSH_PROXY="nc -x 127.0.0.1:1055 %h %p"
# Implemented via a throwaway ssh config referenced with -F (a bare
# -o ProxyCommand=... would shatter when rsync -e flattens ${SSH_OPTS[*]}).
if [ -n "${KAISER_SSH_PROXY:-}" ]; then
  _proxy_cfg="$(mktemp)"
  trap 'rm -f "$_proxy_cfg"' EXIT
  printf 'Host *\n  ProxyCommand %s\n' "$KAISER_SSH_PROXY" > "$_proxy_cfg"
  SSH_OPTS+=(-F "$_proxy_cfg")
fi
RSYNC_OPTS=(
  -a --delete
  --exclude .env
  --exclude .pf-creds
  --exclude .git
  --exclude .venv-domain
  --exclude virtualenv.pyz
)

# --- 0. render templates (cheap; in case .env changed since setup.sh) ----- #
envsubst '${LAN_DOMAIN}' < traefik-lan/dynamic.yml.tmpl > traefik-lan/dynamic.yml
envsubst '${LAN_DOMAIN} ${KAISER_IP}' < coredns/Corefile.tmpl > coredns/Corefile
echo "rendered traefik-lan/dynamic.yml + coredns/Corefile"

# --- 1. pfSense domain override ------------------------------------------ #
if ! $SKIP_DNS; then
  echo
  echo "==> 1/4 pfSense Domain Overrides (LAN_OVERRIDES, fallback LAN_DOMAIN→KAISER_IP)"
  # No CLI args → domain.py reads LAN_OVERRIDES from .env (multi-zone) and
  # falls back to LAN_DOMAIN/KAISER_IP when LAN_OVERRIDES is unset.
  python3 ./domain.py
fi

deploy_repo() {
  # deploy_repo <local_dir> <remote_dir> <project_name> [kauket_secret_id]
  #
  # Without a Kauket id the LOCAL .env is the source of truth and is scp'd to
  # the host (cn-home: the Mac-side .env also drives pfSense / LAN_HOSTS).
  # With a Kauket id the HOST's .env is Kauket-installed: nothing local is
  # copied over it, `kauket get` refreshes it and the repo's setup.sh
  # re-renders templates on the host. Everything the repo gitignores (.env,
  # rendered configs, the fetched root CA) is host state in that mode and is
  # neither pushed nor deleted by rsync. This is what ended the recurring
  # grafana.kaiser.lan "client_id missing or invalid": the Mac's stale
  # cn-observability/.env used to be scp'd over a hand-fixed kaiser copy.
  local local_dir="$1" remote_dir="$2" project_name="$3" kauket_id="${4:-}"
  echo
  echo "==> $local_dir → $KAISER_SSH:$remote_dir (project: $project_name)"

  local -a rsync_opts=("${RSYNC_OPTS[@]}")
  if [ -n "$kauket_id" ]; then
    if [ -f "$local_dir/.gitignore" ]; then
      rsync_opts+=(--exclude-from "$local_dir/.gitignore")
    fi
  elif [ ! -f "$local_dir/.env" ]; then
    echo "missing $local_dir/.env — run ./setup.sh in that directory first" >&2
    return 1
  fi

  ssh "${SSH_OPTS[@]}" "$KAISER_SSH" "mkdir -p '$remote_dir'"
  rsync "${rsync_opts[@]}" -e "ssh ${SSH_OPTS[*]}" "$local_dir/" "$KAISER_SSH:$remote_dir/"

  if [ -n "$kauket_id" ]; then
    # `kauket get` refuses a destination that was edited in place (unmanaged).
    # Fix the value with `kauket add <id> <file> --force` on the Mac and
    # re-run; never edit the host copy.
    ssh "${SSH_OPTS[@]}" "$KAISER_SSH" \
      "cd '$remote_dir' && kauket get '$kauket_id' && ./setup.sh"
  else
    scp "${SSH_OPTS[@]}" "$local_dir/.env" "$KAISER_SSH:$remote_dir/.env"
    if [ -f "$local_dir/certs/root_ca.crt" ]; then
      ssh "${SSH_OPTS[@]}" "$KAISER_SSH" "mkdir -p '$remote_dir/certs'"
      scp "${SSH_OPTS[@]}" "$local_dir/certs/root_ca.crt" "$KAISER_SSH:$remote_dir/certs/root_ca.crt"
    fi
  fi

  ssh "${SSH_OPTS[@]}" "$KAISER_SSH" "cd '$remote_dir' && docker compose -p '$project_name' up -d"
  if [ "$project_name" = cn-home ]; then
    # Single-file bind mounts (dynamic.yml, dynacat.yml) keep the old inode
    # after an rsync and traefik-lan runs without a file watcher: recreate
    # both so the rendered config is what runs (a ~2 s blip of LAN ingress).
    ssh "${SSH_OPTS[@]}" "$KAISER_SSH" \
      "cd '$remote_dir' && docker compose -p '$project_name' up -d --force-recreate --no-deps traefik-lan dynacat"
    sleep 10   # let Traefik reload its ACME store before the verification curls
  fi
}

# --- 2. cn-observability (must be up before cn-home routes to it) -------- #
if $WITH_OBS; then
  OBS_DIR="$(cd .. && pwd)/cn-observability"
  if [ ! -d "$OBS_DIR" ]; then
    echo "cn-observability not found at $OBS_DIR" >&2
    exit 1
  fi
  echo
  echo "==> 2/4 deploying cn-observability"
  # kaiser's cn-observability/.env is Kauket-installed (kaiser.cn_observability_env).
  deploy_repo "$OBS_DIR" "${KAISER_REMOTE_DIR%/cn-home}/cn-observability" "cn-observability" "kaiser.cn_observability_env"
fi

# --- 3. cn-home --------------------------------------------------------- #
echo
echo "==> 3/4 deploying cn-home"
deploy_repo "$HERE" "$KAISER_REMOTE_DIR" "cn-home"

# --- 4. verification block ---------------------------------------------- #
if $SKIP_VERIFY; then
  exit 0
fi

echo
echo "==> 4/4 verification"

SUBDOMAINS=(home grafana prometheus alertmanager loki portainer)
fail=0

echo
echo "  [DNS] each subdomain should resolve to $KAISER_IP (via the system resolver)"
for h in "${SUBDOMAINS[@]}"; do
  ip=""
  if command -v getent >/dev/null 2>&1; then
    ip=$(getent hosts "$h.$LAN_DOMAIN" 2>/dev/null | awk '{print $1}' | head -1 || true)
  fi
  if [ -z "$ip" ]; then
    # macOS doesn't have getent; fall back to `host`.
    # `|| true`: under `set -e -o pipefail` a failed lookup (NXDOMAIN, no
    # `host` binary, VPN resolver) used to abort the whole deploy here with
    # exit 1 and no message, instead of printing the ✗ row below.
    ip=$(host "$h.$LAN_DOMAIN" 2>/dev/null | awk '/has address/ {print $4; exit}' || true)
  fi
  if [ "$ip" = "$KAISER_IP" ]; then
    printf "    %-32s → %s  ✓\n" "$h.$LAN_DOMAIN" "$ip"
  else
    printf "    %-32s → %s  ✗ (expected %s)\n" "$h.$LAN_DOMAIN" "${ip:-NXDOMAIN}" "$KAISER_IP"
    fail=1
  fi
done

echo
echo "  [TLS] curl --cacert each subdomain (200/302/401/404 is fine)"
CACERT="$HERE/certs/root_ca.crt"
for h in "${SUBDOMAINS[@]}"; do
  out=$(curl --cacert "$CACERT" -sS -o /dev/null \
          -w '%{http_code} %{ssl_verify_result}' \
          --max-time 10 "https://$h.$LAN_DOMAIN/" 2>&1 || echo "curl_err")
  code="${out%% *}"
  ssl_rc="${out##* }"
  if [[ "$ssl_rc" = "0" && "$code" =~ ^(200|301|302|401|404)$ ]]; then
    printf "    %-32s HTTP=%s ssl_verify=%s  ✓\n" "$h.$LAN_DOMAIN" "$code" "$ssl_rc"
  else
    printf "    %-32s HTTP=%s ssl_verify=%s  ✗\n" "$h.$LAN_DOMAIN" "$code" "$ssl_rc"
    fail=1
  fi
done

echo
if [ "$fail" -eq 0 ]; then
  echo "  ✓ verification passed"
else
  echo "  ✗ some checks failed — see above"
  exit 1
fi
